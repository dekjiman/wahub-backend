{
  "name": "Wahub - Onboarding Member Baru (Gemini)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "onboarding-new-member",
        "options": {}
      },
      "id": "a7f5c892-66a3-4752-836f-8094fdf13555",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "webhookId": "onboarding-new-member"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst member = body.member || {};\nconst group = body.group || {};\nconst onboardingStatus = (member.onboardingStatus || '').toLowerCase().trim();\nconst instanceName = body.instanceName || 'wahub-main';\nconst groupJid = group.jid || '';\nconst memberName = member.name || member.phone || 'Member Baru';\nconst memberPhone = member.phone || '';\nconst groupName = group.name || 'Grup';\nconst groupRules = group.rules || 'Tidak ada aturan khusus';\nconst groupId = group.id || '';\nconst memberId = member.id || '';\nconst autoWelcome = group.autoWelcome !== false;\n\nif (!autoWelcome) {\n  return [{ json: { skip: true, reason: 'autoWelcome is disabled' } }];\n}\n\nif (!groupJid) {\n  return [{ json: { skip: true, reason: 'group.jid is empty' } }];\n}\n\nif (onboardingStatus && onboardingStatus !== 'pending') {\n  return [{ json: { skip: true, reason: `onboardingStatus is '${onboardingStatus}', not pending` } }];\n}\n\nreturn [{ json: {\n  skip: false,\n  instanceName,\n  groupJid,\n  memberName,\n  memberPhone,\n  groupName,\n  groupRules,\n  groupId,\n  memberId\n}}];"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !$json.skip }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-should-process",
      "name": "Should Process?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.memberPhone }}",
        "options": {
          "systemMessage": "=Kamu adalah asisten komunitas yang ramah dan profesional. Buatkan pesan sambutan untuk member baru di grup WhatsApp.\n\nData Member:\n- Nomor: {{ $json.memberPhone }}\n- Nama: {{ $json.memberName }}\n\nNama Grup: {{ $json.groupName }}\nAturan Grup: {{ $json.groupRules }}\n\nBuat pesan sambutan yang:\n1. Ramah, singkat, santai, dan menggunakan emoji\n2. Sertakan nama grup\n3. Sertakan aturan grup (jika ada, ringkas dalam 3-5 poin)\n4. Di akhir, minta member membalas dengan format:\n   'Nama | Area/Kota | Jenis Usaha'\n   Contoh: Budi Santoso | Jakarta | Kuliner\n5. Jangan pakai markdown tebal atau bintang, cukup teks biasa\n6. Panjang pesan maksimal 500 karakter"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        900,
        200
      ],
      "id": "50f3cd1c-b538-4b80-be07-7cae3902aecd",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        900,
        400
      ],
      "id": "4e23e846-a559-4b82-8efb-96fbda916ebc",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const agentOutput = $json.output || $json.text || $json.message || $json.response || '';\nconst text = String(agentOutput).trim();\n\nconst number = $node['Validate Input'].json.groupJid;\nconst instanceName = $node['Validate Input'].json.instanceName || 'wahub-main';\nconst groupId = $node['Validate Input'].json.groupId;\nconst memberId = $node['Validate Input'].json.memberId;\n\nif (!text) {\n  throw new Error('AI Agent menghasilkan pesan kosong. Pastikan Google Gemini credentials sudah dikonfigurasi di n8n.');\n}\n\nif (!number) {\n  throw new Error('group.jid kosong. Cek webhook payload.');\n}\n\nreturn [{ json: { number, text, instanceName, groupId, memberId } }];"
      },
      "id": "build-message",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://evolution-api:8080/send/text?instance={{ $json.instanceName }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "wahub-evolution-api-key-2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.number, \"text\": $json.text } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "bf6bd753-ebed-4690-8029-9913bf0ec42c",
      "name": "Kirim ke WhatsApp (Evolution Go)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1400,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://wahub-backend:3000/api/internal/workflow-runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-internal-token",
              "value": "wahub-n8n-internal-token-2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "Onboarding New Member",
              "type": "string"
            },
            {
              "name": "triggerType",
              "value": "webhook",
              "type": "string"
            },
            {
              "name": "status",
              "value": "={{ $json.data?.key?.messageId ? 'success' : 'failed' }}",
              "type": "string"
            },
            {
              "name": "groupId",
              "value": "={{ $node['Build Message'].json.groupId }}",
              "type": "string"
            },
            {
              "name": "memberId",
              "value": "={{ $node['Build Message'].json.memberId }}",
              "type": "string"
            },
            {
              "name": "instanceName",
              "value": "={{ $node['Build Message'].json.instanceName }}",
              "type": "string"
            },
            {
              "name": "sentTo",
              "value": "={{ $node['Build Message'].json.number }}",
              "type": "string"
            },
            {
              "name": "messageLength",
              "value": "={{ String($node['Build Message'].json.text).length }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "http-log",
      "name": "Log to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1650,
        200
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Should Process?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Should Process?": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Build Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Message": {
      "main": [
        [
          {
            "node": "Kirim ke WhatsApp (Evolution Go)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kirim ke WhatsApp (Evolution Go)": {
      "main": [
        [
          {
            "node": "Log to Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
