    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json.data || [];\nconst e = $('Buat Tiket Eskalasi').item.json;\nconst a = d.find(x => x.phone) || d[0];\nif (!a || !a.phone) return { json:{skip:true} };\nconst p = a.phone.replace(/[^0-9]/g,'');\nconst ph = p.startsWith('62') ? p : '62'+p;\nconst ai = $('Parse AI Response').item.json;\nreturn { json:{ skip:false, phone:ph+'@s.whatsapp.net', instanceName:ai.instanceName, message:'🚨 *ESKALASI*\\n\\n*Tiket:* '+(e.title||'Issue')+'\\n*Prioritas:* '+(e.priority||'Medium')+'\\n*Grup:* '+(ai.group.name||'')+'\\n*Member:* '+(ai.member.name||'')+'\\n*Alasan:* '+(ai.analysis.reasoning||'')+'\\n\\nSegera ditindaklanjuti.' } };"
      },
