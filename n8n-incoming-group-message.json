    {
      "parameters": {
        "promptType": "define",
        "text": "={{ Edit Fields.item.json.body.message.conversation }}",
        "options": {
          "systemMessage": "Anda adalah sistem AI keamanan dan moderasi tingkat lanjut. Analisis pesan WhatsApp dari grup dan berikan output JSON.\n\nKONTEKS DATA:\n- group: { id, name, jid, rules }\n- member: { id, phone, name, onboardingStatus }\n- message: { conversation, from, fromMe, pushName, groupId, groupName }\n\nANALISIS:\n1. Spam/Fraud: phishing, promosi berlebihan, tautan berbahaya\n2. Konten Tidak Pantas: hate speech, pelecehan, bahasa kasar\n3. Ancaman: ancaman fisik, pemerasan, intimidasi\n4. Prioritas: Low/Medium/High/Urgent\n5. Aksi: ALLOW (normal), FLAG_REVIEW (curiga), BLOCK (pelanggaran), ESCALATE (serius)\n\nATURAN:\n- Pesan normal = ALLOW\n- Curiga tapi belum parah = FLAG_REVIEW\n- Spam/konten pantas = BLOCK\n- Ancaman serius/fraud berat = ESCALATE\n\nOUTPUT JSON:\n{\"analysis\":{\"is_spam_or_fraud\":bool,\"is_inappropriate\":bool,\"is_threat\":bool,\"confidence_score\":float,\"reasoning\":\"string\"},\"priority\":\"Low|Medium|High|Urgent\",\"recommended_action\":\"ALLOW|BLOCK|FLAG_REVIEW|ESCALATE\",\"warning_message\":\"pesan peringatan Indonesia\",\"escalation_ticket\":{\"needs_escalation\":bool,\"department\":\"Security|Fraud|Content Moderation|Customer Support|None\",\"ticket_title\":\"string\",\"ticket_description\":\"string\"}}"
        }
      },
      "id": "9c1919cc-ec50-4499-a126-8d21dde03cd7",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        352,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemma-4-26b-a4b-it",
        "options": {}
      },
      "id": "846a8ddd-4400-4da6-a700-4fbfa8baa3cb",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        352,
        208
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "dr1Fz5657TncepDQ",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Node mode: Run Once for Each Item\n// Pada mode ini gunakan $json untuk item AI Agent saat ini.\n// Jangan gunakan $input.first().\n\nconst aiOutput = String(\n  $json.output ??\n  $json.text ??\n  ''\n).trim();\n\nif (!aiOutput) {\n  throw new Error(\n    'AI Agent menghasilkan output kosong. Cek output node AI Agent sebelum Parse AI Response.'\n  );\n}\n\n// Bersihkan kemungkinan markdown code fence dari output model.\nlet cleaned = aiOutput\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet parsed;\n\ntry {\n  // Pilihan utama: AI mengembalikan JSON murni.\n  parsed = JSON.parse(cleaned);\n} catch (firstError) {\n  // Fallback: ambil object JSON pertama dari text tambahan model.\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n\n  if (start === -1 || end === -1 || end <= start) {\n    throw new Error(\n      'Tidak menemukan object JSON pada output AI. Output: ' +\n      cleaned.slice(0, 500)\n    );\n  }\n\n  const jsonCandidate = cleaned.slice(start, end + 1);\n\n  try {\n    parsed = JSON.parse(jsonCandidate);\n  } catch (secondError) {\n    throw new Error(\n      'Output AI bukan JSON valid. ' +\n      secondError.message +\n      ' | Output: ' +\n      jsonCandidate.slice(0, 500)\n    );\n  }\n}\n\n// Ambil context asli dari Webhook.\n// Karena workflow linear Webhook -> Edit Fields -> AI Agent -> Parse,\n// .item akan mengikuti linked item yang sama.\nconst wb = $('Webhook').item.json.body ?? {};\n\nconst defaults = {\n  analysis: {\n    is_spam_or_fraud: false,\n    is_inappropriate: false,\n    is_threat: false,\n    confidence_score: 0,\n    reasoning: ''\n  },\n  priority: 'Low',\n  recommended_action: 'ALLOW',\n  warning_message: '',\n  escalation_ticket: {\n    needs_escalation: false,\n    department: 'None',\n    ticket_title: '',\n    ticket_description: ''\n  }\n};\n\n// Merge nested object dengan aman.\nconst result = {\n  ...defaults,\n  ...parsed,\n  analysis: {\n    ...defaults.analysis,\n    ...(parsed.analysis ?? {})\n  },\n  escalation_ticket: {\n    ...defaults.escalation_ticket,\n    ...(parsed.escalation_ticket ?? {})\n  },\n  group: wb.group ?? {},\n  member: wb.member ?? {},\n  message: wb.message ?? {},\n  instanceName: wb.instanceName ?? 'wahub-main'\n};\n\n// Validasi output minimum agar Switch tidak salah routing.\nconst validActions = ['ALLOW', 'BLOCK', 'FLAG_REVIEW', 'ESCALATE'];\nif (!validActions.includes(result.recommended_action)) {\n  throw new Error(\n    `recommended_action tidak valid: ${result.recommended_action}`\n  );\n}\n\nreturn {\n  json: result\n};"
      },
