# Server
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://wahub:password@localhost:5432/wahub

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-strong-random-secret
JWT_EXPIRES_IN=24h

# Evolution API (WhatsApp gateway)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-evolution-api-key
EVOLUTION_OPERATOR_EMAIL=operator@example.com
EVOLUTION_WEBHOOK_URL=https://api.staging.domain.com/webhook/evolution

# AI/LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Frontend CORS
FRONTEND_URL=https://admin.staging.domain.com

# Bootstrap super admin (created only when admins table is empty)
ADMIN_EMAIL=admin@wahub.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Super Admin

# n8n Automation Engine
N8N_URL=http://n8n:5678
N8N_WEBHOOK_URL=https://api.staging.domain.com/webhook/onboarding-new-member
N8N_INTERNAL_TOKEN=change-me-n8n-internal-token
